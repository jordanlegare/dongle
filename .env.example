# Lattice Sandboxes. Set these in /etc/dongle/lattice.env on the authd host.
# LATTICE_ENDPOINT is hostname-only (do not include https:// or a path).
LATTICE_ENDPOINT=your-environment.env.sandboxes.developer.anduril.com
ENVIRONMENT_TOKEN=replace-with-lattice-auth-token
SANDBOXES_TOKEN=replace-with-account-sandbox-token

# Optional Rust logging filter.
RUST_LOG=info
