# Build-time, non-secret configuration for the UEFI application.
# These values are compiled into the signed .efi image. Rebuild/re-sign when
# changing an identity or service endpoint. Do not put credentials or PINs here.

DONGLE_UEFI_SERVER=https://dongle-auth.example.internal
DONGLE_UEFI_USER_ID=operator
DONGLE_UEFI_DONGLE_ID=operator-key-01
DONGLE_UEFI_ASSET_ID=linux-workstation-01

# Full UEFI device path to the signed next-stage loader on this machine's ESP.
# Obtain the exact value from the firmware Boot#### entry/device-path tooling;
# the example below is intentionally a placeholder and is not a valid device path.
DONGLE_UEFI_NEXT_BOOT_DEVICE_PATH='PciRoot(0x0)/Pci(0x1f,0x2)/HD(1,GPT,REPLACE-PARTITION-GUID,0x800,0x100000)/File(\EFI\ubuntu\shimx64.efi)'
