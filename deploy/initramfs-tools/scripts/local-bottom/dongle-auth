#!/bin/sh
PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /scripts/functions

# Keep the splash self-contained: initramfs-tools does not need Plymouth,
# dialog, tput, or any other UI package for this console-only boot gate.
render_splash() {
    state="$1"

    printf '\033[2J\033[H'
    printf '\033[1;36m'
    printf '%s\n' '+----------------------------------------------------------------------+'
    printf '%s\n' '|                                                                      |'
    printf '%s\n' '|                         D O N G L E                                 |'
    printf '%s\n' '|                HARDWARE-BACKED BOOT AUTHORIZATION                    |'
    printf '%s\n' '|                                                                      |'
    printf '%s\n' '+----------------------------------------------------------------------+'
    printf '%s\n' '|                                                                      |'

    case "$state" in
        wait)
            printf '\033[1;33m'
            printf '%s\n' '|   STATUS     AUTHORIZATION IN PROGRESS                              |'
            printf '\033[0m\033[1;37m'
            printf '%s\n' '|                                                                      |'
            printf '%s\n' '|   CHECKS     SECURITY KEY  /  TPM 2.0  /  MEASURED BOOT               |'
            printf '%s\n' '|                                                                      |'
            printf '%s\n' '|   ACTION     WAITING FOR A VERIFIED POLICY DECISION                 |'
            printf '%s\n' '|                                                                      |'
            printf '%s\n' '|   Please wait. Keep your security key connected.                    |'
            printf '%s\n' '|   Enter its PIN if your token prompts you.                           |'
            ;;
        allow)
            printf '\033[1;32m'
            printf '%s\n' '|   STATUS     ACCESS GRANTED                                          |'
            printf '\033[0m\033[1;37m'
            printf '%s\n' '|                                                                      |'
            printf '%s\n' '|   RESULT     TOKEN IDENTITY VERIFIED                                 |'
            printf '%s\n' '|              TPM MEASUREMENTS APPROVED BY DEVICE POLICY             |'
            printf '%s\n' '|                                                                      |'
            printf '%s\n' '|   ACTION     switch_root                                             |'
            printf '%s\n' '|                                                                      |'
            printf '%s\n' '|   Trusted boot confirmed. Handing control to Linux.                  |'
            ;;
        deny)
            printf '\033[1;31m'
            printf '%s\n' '|   STATUS     ACCESS DENIED                                           |'
            printf '\033[0m\033[1;37m'
            printf '%s\n' '|                                                                      |'
            printf '%s\n' '|   RESULT     AUTHORIZATION FAILED OR UNAVAILABLE                    |'
            printf '%s\n' '|                                                                      |'
            printf '%s\n' '|   ACTION     INITRAMFS PANIC                                         |'
            printf '%s\n' '|                                                                      |'
            printf '%s\n' '|   The real root will not be entered.                                |'
            printf '%s\n' '|   Contact your system administrator or use the approved recovery.  |'
            ;;
    esac

    printf '\033[0m'
    printf '%s\n' '|                                                                      |'
    printf '%s\n' '+----------------------------------------------------------------------+'
}

show_splash() {
    if [ -c /dev/console ]; then
        render_splash "$1" > /dev/console 2>/dev/null
    else
        render_splash "$1"
    fi
}

deny_boot() {
    # A short hold makes the denial state readable before initramfs panic.
    show_splash deny
    sleep 2
    panic "$1"
    exit 1
}

show_splash wait

if [ ! -x /usr/local/sbin/dongle-agent ]; then
    deny_boot "dongle-agent is missing from initramfs; refusing to continue boot"
fi

mkdir -p /run/pcscd
if [ -x /usr/sbin/pcscd ]; then
    /usr/sbin/pcscd --auto-exit || deny_boot "could not start PC/SC daemon"
fi

if /usr/local/sbin/dongle-agent /etc/dongle/agent.toml; then
    show_splash allow
    sleep 1
    exit 0
fi

deny_boot "dongle authorization denied or unavailable; refusing to switch to the real root"
