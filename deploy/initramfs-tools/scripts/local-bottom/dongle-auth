#!/bin/sh
PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /scripts/functions

if [ ! -x /usr/local/sbin/dongle-agent ]; then
    panic "dongle-agent is missing from initramfs; refusing to continue boot"
fi

mkdir -p /run/pcscd
if [ -x /usr/sbin/pcscd ]; then
    /usr/sbin/pcscd --auto-exit || panic "could not start PC/SC daemon"
fi

if /usr/local/sbin/dongle-agent /etc/dongle/agent.toml; then
    echo "dongle authorization accepted"
    exit 0
fi

panic "dongle authorization denied or unavailable; refusing to switch to the real root"
